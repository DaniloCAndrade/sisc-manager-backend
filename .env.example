# .env.example — copie para .env e preencha os valores reais
# Nunca commite o .env com valores reais no repositório

# ── MongoDB Atlas ─────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<usuario>:<senha>@siscmanager.8yspzsr.mongodb.net/siscVery

# ── Autenticação JWT ──────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES=8h

# ── Comunicação service-to-service ────────────────────────────────
SERVICE_API_KEY=troque-por-uma-chave-aleatoria

# ── Cache ─────────────────────────────────────────────────────────
TENANTS_CACHE_INTERVAL_MS=300000